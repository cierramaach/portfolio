# Optional SHA-256 hex of SALT + password.
# If unset, the first visit to /edit creates a password in this browser.
# VITE_EDITOR_HASH=

# Receiving address for the mail form, if not set in edit mode.
# VITE_CONTACT_EMAIL=

# Optional. If set, mail goes through Web3Forms instead of FormSubmit.
# VITE_WEB3FORMS_KEY=
